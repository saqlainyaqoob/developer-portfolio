NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://portfolio_user:CHANGE_ME@localhost:5433/portfolio_db

# PostgreSQL connection pool
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000


# Your public mobile app's allowed origin will be configured later.
CORS_ORIGIN=*

# Email notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
CONTACT_RECEIVER_EMAIL=
