# ──────────────────────────────────────────────────────────────────────
#  Environment configuration (optional overrides)
# ──────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your real values.
#
# SECURITY: EXPO_PUBLIC_* variables are embedded in the app bundle by
# design. Only public, non-secret values belong here — never API keys,
# tokens, or passwords.

# Public contact email used for the mailto: compose fallback
EXPO_PUBLIC_CONTACT_EMAIL=your.email@example.com

# Public professional profile URLs
EXPO_PUBLIC_GITHUB_URL=https://github.com/yourusername
EXPO_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/yourusername

EXPO_PUBLIC_API_URL=http://192.168.100.5:4000
